<div class="logo">Daytona</div>

<div class="card">
  <div class="card-header">
    <h1 class="card-title">Sign Out</h1>
    <p class="card-description">Are you sure you want to sign out?</p>
  </div>

  <div class="card-content">
    <%- form %>
    <button autofocus type="submit" form="op.logoutForm" value="yes" name="logout" class="btn-primary">
      Yes, Sign Out
    </button>
  </div>
</div>
